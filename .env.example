# Copy this file to ".env" (same folder) and fill in the values. ".env" is never uploaded to GitHub.

# --- SMS one-time codes (required for reporters to verify their mobile number) ---
# Fast2SMS: https://www.fast2sms.com  ->  Dev API  ->  copy your API key
FAST2SMS_API_KEY=
# 'otp' (default) or 'q' (Quick SMS). Check which one is enabled / cheaper in your Fast2SMS dashboard.
FAST2SMS_ROUTE=otp
# Most SMS the whole site may send per day (protects your balance)
SMS_DAILY_LIMIT=300

# --- WhatsApp one-time codes (optional, can be used with SMS or on its own) ---
# Meta WhatsApp Business Cloud API: developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Name of your approved "Authentication" message template, and its language exactly as shown in WhatsApp Manager
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US

# --- Google Maps (for the map on the HOD / Admin Office dashboards) ---
# Google Cloud Console -> enable "Maps JavaScript API" -> create an API key (restrict it to your website address)
GOOGLE_MAPS_API_KEY=

# --- Staff sign-up ---
# The code the HOD and Admin Office type on the sign-up page. Leave empty to auto-generate one.
STAFF_CODE=
